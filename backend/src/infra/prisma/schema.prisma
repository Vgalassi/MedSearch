generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  CLINIC
}

model User {
  id       String @id @db.Uuid
  email    String @unique
  password String
  role     Role

  patient  Patient?
  doctor   Doctor?
  clinic   Clinic?

  @@map("users")
}

model Patient {
  id      String @id @db.Uuid
  userId  String @unique @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  cpf     String @unique

  @@map("patients")
}

model Clinic {
  id          String @id @db.Uuid
  userId      String @unique @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  phone       String

  address     String
  cep         String
  latitude    Float
  longitude   Float
  description String

  doctors     Doctor[]

  @@map("clinics")
}

model Doctor {
  id         String @id @db.Uuid
  userId     String @unique @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  phone      String

  crm        String  @unique
  speciality String

  clinicId   String? @db.Uuid
  clinic     Clinic? @relation(fields: [clinicId], references: [id])

  @@map("doctors")
}