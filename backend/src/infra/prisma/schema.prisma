generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  MEDIC
  CLINIC
}

model User {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  email    String @unique
  password String
  phone    String
  role     Role

  patient  Patient?
  medic    Medic?
  clinic   Clinic?
}

model Patient {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @unique @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cpf       String @unique
}

model Clinic {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @unique @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address     String
  cep         String
  latitude    Float
  longitude   Float
  description String

  medics      Medic[]
}

model Medic {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String @unique @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  crm        String  @unique
  speciality String

  clinicId   String? @db.Uuid
  clinic     Clinic? @relation(fields: [clinicId], references: [id])
}