generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  CLINIC
}

enum AppointmentStatus {
  SCHEDULED
  CANCELED
  COMPLETED
  OCURRING
  NO_SHOW
}

enum AppointmentType {
  ONLINE
  OFFLINE
}


enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityMode {
  ONLINE
  OFFLINE
  BOTH
}

enum NotificationType {
  APPOINTMENT_REMINDER
  CLINIC_INVITATION
  CLINIC_INVITATION_RESPONSE
}

enum ClinicInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id       String @id @db.Uuid
  email    String @unique
  password String
  role     Role

  patient  Patient?
  doctor   Doctor?
  clinic   Clinic?
  notifications Notification[]

  @@map("users")
}

model Patient {
  id      String @id @db.Uuid
  userId  String @unique @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  cpf     String @unique

  appointments Appointment[]

  @@map("patients")
}

model Clinic {
  id          String @id @db.Uuid
  userId      String @unique @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  phone       String

  street      String
  city        String
  state       String
  number      String
  cep         String
  latitude    Float
  longitude   Float
  description String

  doctors     Doctor[]
  invitations ClinicInvitation[]

  @@map("clinics")
}

model Doctor {
  id         String @id @db.Uuid
  userId     String @unique @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  phone      String

  crm        String  @unique
  speciality String

  clinicId   String? @db.Uuid
  clinic     Clinic? @relation(fields: [clinicId], references: [id])

  appointments Appointment[]
  settings     DoctorSettings?
  availabilities Availability[]
  invitations ClinicInvitation[]

  @@map("doctors")
}

model Notification {
  id        String @id @db.Uuid
  userId    String @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model ClinicInvitation {
  id        String @id @db.Uuid
  clinicId  String @db.Uuid
  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId  String @db.Uuid
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status    ClinicInvitationStatus @default(PENDING)
  createdAt DateTime @default(now())
  respondedAt DateTime?

  @@index([doctorId, status])
  @@index([clinicId, status])
  @@map("clinic_invitations")
}

model Appointment {
  id          String @id @db.Uuid

  patientId   String @db.Uuid
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId    String @db.Uuid
  doctor      Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  startTime   Int
  endTime     Int
  day         DateTime

  status      AppointmentStatus @default(SCHEDULED)
  type        AppointmentType

  reason      String?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doctorId, day, startTime])
  @@index([patientId, day, startTime])

  @@map("appointments")
}

model DoctorSettings {
  id                   String @id @db.Uuid

  doctorId             String @unique @db.Uuid
  doctor               Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  isAvaliable          Boolean

  defaultDuration      Int   

  bufferBetween        Int   
  maxSchedullingDays   Int
  advanceBookingHours  Int   

  maxDailyAppointments Int?  
  @@map("doctor_settings")
}

model Availability {
  id String @id @db.Uuid

  doctorId String @db.Uuid
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  weekdays WeekDay[]

  startMinutes Int
  endMinutes   Int

  createdAt DateTime @default(now())
  mode AvailabilityMode

  @@index([doctorId])

  @@map("availabilities")
}
